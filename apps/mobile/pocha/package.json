{
  "name": "pocha",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --no-packager",
    "ios": "react-native run-ios --no-packager",
    "lint": "eslint .",
    "start": "react-native start",
    "start-local": "node args.ts -l && react-native start",
    "start:standalone": "STANDALONE=1 react-native start",
    "test": "jest",
    "full-install": "pnpm install && pnpm dlx pod-install ios",
    "clear": "rm -rf node_modules",
    "clear-pod": "cd ios && rm -rf ~/Library/Caches/CocoaPods && rm -rf Pods && rm -rf build && rm -rf Podfile.lock && rm -rf ~/Library/Developer/Xcode/DerivedData/* && pod cache clean --all && pod deintegrate && pod setup && cd .."
  },
  "dependencies": {
    "@babel/runtime": "7.26.10",
    "@react-native-firebase/app": "^19.0.0",
    "@react-native-firebase/auth": "^19.0.0",
    "@react-native-firebase/messaging": "21.12.3",
    "@react-native-google-signin/google-signin": "13.2.0",
    "@react-navigation/material-top-tabs": "7.1.1",
    "@react-navigation/native": "7.0.15",
    "@react-navigation/native-stack": "7.2.1",
    "@repo/ui": "workspace:*",
    "@stripe/stripe-react-native": "^0.43.0",
    "axios": "^0.x",
    "babel-plugin-module-resolver": "5.0.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "react": "19.0.0",
    "react-native": "0.78.1",
    "react-native-check-box": "^2.1.7",
    "react-native-dotenv": "3.4.11",
    "react-native-keychain": "10.0.0",
    "react-native-pager-view": "6.7.0",
    "react-native-pure-jwt": "3.0.3",
    "react-native-safe-area-context": "5.3.0",
    "react-native-screens": "4.9.2",
    "react-native-svg": "15.11.2",
    "react-native-ui-datepicker": "^3.1.2",
    "react-native-vector-icons": "10.2.0",
    "stripe": "17.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "7.25.9",
    "@babel/preset-env": "^7.25.3",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.1",
    "@react-native/eslint-config": "0.78.1",
    "@react-native/metro-config": "0.78.1",
    "@react-native/typescript-config": "0.78.1",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.16",
    "@types/react": "^19.0.0",
    "@types/react-native-check-box": "^2.1.6",
    "@types/react-native-dotenv": "0.2.2",
    "@types/react-navigation": "^3.4.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "1.5.0",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.6.3"
}
